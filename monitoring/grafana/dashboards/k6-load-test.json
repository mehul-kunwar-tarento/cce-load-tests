{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "expr": "max by (testid, service, test_type) (k6_vus{testid=~\"$testid\"})",
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 0.4)",
        "name": "k6 test runs",
        "step": "10s",
        "tagKeys": "testid,service,test_type",
        "textFormat": "{{service}} {{test_type}}",
        "titleFormat": "k6 run {{testid}}",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(115, 191, 105, 1)",
        "name": "Run markers (selected run)",
        "target": {
          "limit": 200,
          "matchAny": false,
          "tags": ["cce-performance", "$testid"],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "hide": false,
        "iconColor": "rgba(184, 119, 217, 1)",
        "name": "Run markers (every run)",
        "target": {
          "limit": 200,
          "matchAny": false,
          "tags": ["cce-performance"],
          "type": "tags"
        }
      }
