      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"cce-collector-service\",uri=\"/v1/events\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"cce-collector-service\",uri=\"/v1/events\"}[1m])) * 1000",
          "legendFormat": "average",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
