# .env.example — names of the variables monitoring/docker-compose.yml reads (NO values here)
#
# What:    Template for monitoring/.env. Compose reads monitoring/.env automatically because it sits next
#          to docker-compose.yml. Preferred instead: export the variables in your shell for the session.
# How:     cp monitoring/.env.example monitoring/.env, then fill the values in monitoring/.env only.
#          monitoring/.env is git-ignored; never commit it and never put values into this file.
# Needs:   The Grafana admin password you want for the laptop Grafana, and the Postgres password of
#          local-stack's cce_user (the same DB_PASSWORD the test tooling uses).
# Outputs: Nothing by itself; docker compose substitutes the values into the stack.

# Required: Grafana admin password (also used by the test runner for run annotations when no
# GRAFANA_API_TOKEN is set).
GRAFANA_ADMIN_PASSWORD=

# Required: password of cce_user, read by postgres-exporter.
DB_PASSWORD=

# Optional overrides (defaults in brackets).
# PROMETHEUS_PORT=   [9095]
# GRAFANA_PORT=      [3030]
# CCE_NETWORK=       [cce-net]
