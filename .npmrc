# What:    npm settings for this repository.
# How:     Read automatically by npm in this folder (npm install, npm test, …).
# Needs:   npm 10+ (comes with Node.js 22).
# Outputs: save-exact pins every dependency to one exact version in package.json; engine-strict refuses
#          to install on a Node.js version older than package.json "engines" allows.
save-exact=true
engine-strict=true
